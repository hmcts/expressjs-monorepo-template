{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "minimumReleaseAge": "3 days",
  "schedule": ["after 8am and before 4pm every weekday"],
  "automergeSchedule": ["after 8am and before 4pm every weekday"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Node.js major version of the HMCTS base image in Dockerfiles",
      "managerFilePatterns": ["/(^|/)Dockerfile[^/]*$/"],
      "matchStrings": ["FROM\\s+(?:\\S+/)?node:(?<currentValue>[0-9]+)-alpine"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      "description": "The custom Dockerfile manager owns the base image's Node.js version",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["hmctsprod.azurecr.io/base/node"],
      "enabled": false
    },
    {
      "description": "Group all Node.js version updates",
      "groupName": "Node.js version",
      "matchPackageNames": ["node"],
      "matchManagers": ["custom.regex", "nvm"],
      "matchDatasources": ["node-version"],
      "enabled": true
    },
    {
      "description": "Auto-merge Node.js minor and patch updates",
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Require approval for Node.js major updates",
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep the Prisma CLI and client on the same version",
      "groupName": "Prisma",
      "matchPackageNames": ["prisma", "@prisma/**"]
    }
  ],
  "constraints": {
    "node": ">=22"
  }
}
