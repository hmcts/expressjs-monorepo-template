# Git
.git/
**/.gitignore
**/.gitattributes

# Development files
**/.env
**/.env.*
!**/.env.example
**/*.log

# Dependencies
**/node_modules/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build outputs
**/dist/
**/build/
**/generated/
**/*.tsbuildinfo
**/coverage/
**/.nyc_output/
**/lcov.info

# Testing
**/test-results/
**/playwright-report/
**/*.test.ts
**/*.spec.ts
.playwright-mcp/

# e2e-tests is a workspace, so its manifest is needed for an immutable install
e2e-tests/*
!e2e-tests/package.json

# IDE
.vscode/
.idea/
.devcontainer/
**/*.swp
**/*.swo
**/*~
**/.DS_Store

# Documentation
**/*.md
docs/
templates/

# Deployment
helm/
infrastructure/

# CI/CD
.github/
**/.turbo/
.dockerignore
**/Dockerfile*

# MCP
.mcp.env
.claude/

# Temporary files
tmp/
temp/
